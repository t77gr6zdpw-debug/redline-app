# URL of your own serverless endpoint (Vercel/Netlify/Cloudflare Worker) that
# receives the lead form JSON and forwards it to Telegram Bot API / email /
# CRM using server-side secrets. Never put a Telegram bot token in client code.
# If unset, the form shows a graceful "write to us on Telegram" fallback.
VITE_LEAD_ENDPOINT=

# Direct Telegram link shown as a fallback contact when VITE_LEAD_ENDPOINT is
# not configured or a submission fails, e.g. https://t.me/your_manager
VITE_TELEGRAM_CONTACT_URL=

# Public link to the «Про Бізнес» Telegram channel, shown in the footer.
VITE_PROBIZNES_TELEGRAM_URL=
